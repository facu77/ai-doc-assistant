{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make verify)",
      "Bash(make eval)",
      "Bash(make specs)",
      "Bash(./scripts/verify.sh *)",
      "Bash(./scripts/eval.sh *)",
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv tree *)",
      "Bash(uv pip show *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(npm ls *)",
      "Bash(docker compose -f deploy/compose.yaml config *)",
      "Bash(docker compose -f deploy/compose.yaml ps *)",
      "Bash(docker compose -f deploy/compose.yaml logs *)",
      "Bash(docker compose -f deploy/compose.yaml up *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(openspec list *)",
      "Bash(openspec show *)",
      "Bash(openspec status *)",
      "Bash(openspec validate *)",
      "Bash(openspec instructions *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git worktree remove *)",
      "Bash(rm *)",
      "Bash(docker compose -f deploy/compose.yaml down *)",
      "Bash(docker system *)",
      "Bash(docker volume *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(kind *)",
      "Bash(gh *)",
      "Bash(npm publish *)",
      "Bash(openspec archive *)",
      "Edit(/evals/golden/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.sh\""
          }
        ]
      }
    ]
  }
}
