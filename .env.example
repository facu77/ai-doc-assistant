# Copiá este archivo a .env y completá. Nunca commitees .env.
# Proveedor LLM (add-llm-client): anthropic | openai | fake
LLM_PROVIDER=fake
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Solo para `make test-integration` con OpenAI: modelo a usar (no hay default).
OPENAI_INTEGRATION_MODEL=

# Embeddings (add-llm-client): local | fake. Si se cambia el modelo, hay que reindexar todo.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_BATCH_SIZE=64

# Juez de la evaluación (add-rag-core)
EVAL_JUDGE_PROVIDER=anthropic
EVAL_JUDGE_MODEL=claude-haiku-5-5

# Ingesta y OCR (add-ingest-pipeline). Cambiar cualquiera de estos (salvo el timeout)
# cambia el config_hash y fuerza reprocesar los documentos.
INGEST_MIN_NATIVE_CHARS=50
INGEST_MIN_PRINTABLE_RATIO=0.9
INGEST_OCR_DPI=300
INGEST_OCR_LANG=spa+eng
INGEST_OCR_PSM=3
INGEST_OCR_TIMEOUT_S=120

# Vector store (add-vector-index)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

# Observabilidad (add-observability-security)
MLFLOW_TRACKING_URI=http://mlflow:5000
LOG_LEVEL=INFO
