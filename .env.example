# Copiá este archivo a .env y completá. Nunca commitees .env.
# Proveedor LLM (add-llm-client): anthropic | openai | ollama | fake
LLM_PROVIDER=fake
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Vector store (add-vector-index)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333

# Observabilidad (add-observability-security)
MLFLOW_TRACKING_URI=http://mlflow:5000
LOG_LEVEL=INFO
